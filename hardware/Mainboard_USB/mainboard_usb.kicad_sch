(symbol (lib_id "MBUSB:VEML7700_Breakout") (at 271.78 241.3 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "bcc1b2c3-39ad-53e1-b88f-e13eb8847bef") (property "Reference" "J14" (at 266.7 233.68 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "Adafruit 4162 VEML7700" (at 266.7 248.92 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "MBUSB:Adafruit_VEML7700_Breakout_Socket_1x05" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "https://www.sullinscorp.com/drawings/78_P(N)PxCxxxLFBN-RC,_10492-H.pdf" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Description" "Adafruit 4162 VEML7700 lux sensor breakout (STEMMA QT version) on a 1x5 socket, sensor facing out. Pin order from Adafruit's board files: 1 VIN, 2 3Vo, 3 GND, 4 SCL, 5 SDA. On-board AP2112 3.3 V regulator, BSS138 level shifters and 4.7k pull-ups to VIN; I2C 0x10. Feed VIN from +3V3 so the bus stays at 3.3 V" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "MPN" "PPTC051LFBN-RC" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Manufacturer" "Sullins" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Vendor Part #" "S6103-ND" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Price" "0.44" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Vendor Link" "https://www.digikey.com/en/products/detail/sullins-connector-solutions/PPTC051LFBN-RC/807239" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Also order" "1x Adafruit 4162 (Adafruit 4162, $4.95 ea)" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Bench light sensor (John, 10/31): VEML7700 at 0x10 on I2C-A, powered from the I2C-A adapter's 3.3 V. Front of the wing, below the V, facing the room. SB1-A's own VEML7700 (U4) is DNP: same address" (at 271.78 241.3 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid "d086e754-bade-555c-902c-89676c6c47b7")) (pin "2" (uuid "e1d02b0d-2ba0-5577-b4c2-e6c8adafb08f")) (pin "3" (uuid "02cc3d7d-8c12-5c74-af97-33f5daff8ea1")) (pin "4" (uuid "5ba6ee74-f17b-5cca-ac85-7b13aeb09650")) (pin "5" (uuid "8008afde-dcbf-5ea3-9083-49b551cf527e")) (instances (project "moveOmeter_MBUSB" (path "/3db34ae1-56f2-53fa-9a96-0e8eada78f45/d1182312-44e8-5e91-a060-56ffc513e440" (reference "J14") (unit 1)))))
