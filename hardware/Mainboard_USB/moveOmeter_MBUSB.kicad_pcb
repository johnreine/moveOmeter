	(gr_text "FRONT faces the room: the two SB1s stand 35 mm out in a 90 deg V (apex at X 50); the holder bolts to H5-H8."
		(at 153 45)
		(layer "Cmts.User")
		(uuid "1b6919ef-dd1c-5349-9479-ec2762769177")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "J2 (left) takes SB1-A, J3 (right) takes SB1-B: 20-way FFC, ear-tab ZIFs on end inside the V, both opening toward -X (J2 turned round 11/8: SB1-A cable swings in from the left)."
		(at 153 48)
		(layer "Cmts.User")
		(uuid "4a7e58f3-412d-52be-b967-364895bacd14")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Keep the front strips from each ZIF mouth in toward the apex (FFC loop path) free of parts. Cable: pin n to pin n, same-side contacts (Type A), ~51 mm."
		(at 153 51)
		(layer "Cmts.User")
		(uuid "8b51dee9-8840-50f1-b637-e888d64ad7bb")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "BACK: I2C / mic / status headers in the core, the four CP2102 UART headers and parking pads on the wing below."
		(at 153 54)
		(layer "Cmts.User")
		(uuid "c19fb558-e22e-5a8c-98f6-43549c26fb03")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Foam-tape each adapter to its silk pad and zip-tie its USB cable through the slot pair below it."
