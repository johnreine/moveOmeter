		(fill (thermal_gap 0.3) (thermal_bridge_width 0.4) (island_removal_mode 0))
		(polygon (pts (xy 50 40) (xy 150 40) (xy 150 161) (xy 50 161)))
	)
	(embedded_fonts no)
)
