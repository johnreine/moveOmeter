	(footprint "SB1:Adafruit_I2S_Mic_Breakout_1x06_Overhang_Back"
		(layer "B.Cu")
		(uuid "bdccbc78-1c96-505d-aa7a-476e12a2492d")
		(at 60 42)
		(descr "Adafruit I2S MEMS mic breakout (6049 ICS-43434) on the BACK at the board edge, flat against the board, header pins through both, overhanging the edge, sound-hole side toward the board. Place on B.Cu (drawn mirrored). Pins 1 3V, 2 GND, 3 BCLK, 4 DOUT, 5 LRCL, 6 SEL (from Adafruit's board files). F.Fab and the courtyard show the whole breakout, which reaches 8.2 mm past the board edge when the header row is 2 mm in. ~2.6 mm off the board.")
