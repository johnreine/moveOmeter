		(stroke (width 0.05) (type solid))
		(fill no)
		(layer "Edge.Cuts")
		(uuid "e8175967-ade7-5fb2-af91-86d7cfc29816")
	)
	(gr_text "FRONT (this side) faces the room: mics J1 / J2 at the top, LD6004 (J4), LD2450 (J5) upright (patches up), VEML7700 (U4)."
		(at 95 45)
		(layer "Cmts.User")
		(uuid "5d065f30-5951-5ded-83cf-644a7eba53f9")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Screws from the front into heat-set inserts in the holder: keep 3.0 mm (front) / 3.3 mm (back) clear round each hole."
		(at 95 48)
		(layer "Cmts.User")
		(uuid "b2ef9a08-f2b5-5b1f-8674-e395b23623ec")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Front: nothing taller than the radar faces in their field of view. No through-hole pins behind the radars."
		(at 95 51)
		(layer "Cmts.User")
		(uuid "caa23b7c-8a9a-5912-a39b-b2c65c7a145c")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Behind the LD2450 + 3 mm: solid GND on every layer (rule area on B.Cu / In1 / In2: no tracks, vias or parts)."
		(at 95 54)
		(layer "Cmts.User")
		(uuid "14363324-473c-5748-a506-a20224cfd226")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "In1 / In2 are GND planes (layer type power): no tracks on them anywhere (custom DRC rule). Route on F.Cu / B.Cu only."
		(at 95 57)
		(layer "Cmts.User")
		(uuid "f1bbb15d-e177-5072-9348-2eb0b00d3dd4")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Mounting holes: no tracks or vias within 3.0 mm (front, screw head) / 3.3 mm (back, insert) of each hole centre."
		(at 95 60)
		(layer "Cmts.User")
		(uuid "e4cef03f-a743-5827-88f4-97634686104f")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "BACK: one FFC ZIF, J7 (left edge), opening toward the centre (J3 removed 11/8). SB1-B: J7 at the outer end, cable lies flat toward the apex ~11 mm, then loops into the V. SB1-A: J7 near the apex, cable lies flat out along the back ~24 mm, then swings 135 deg into the Mainboard. Keep the back clear in the cable lanes."
		(at 95 63)
		(layer "Cmts.User")
		(uuid "c550a052-9753-54ab-bf5a-75ca93607f21")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
	(gr_text "Two identical SB1s stand in a 90 deg V (point toward the room); the Mainboard stands upright behind them, parallel to the wall."
		(at 95 66)
		(layer "Cmts.User")
		(uuid "f3da9731-04fb-5165-9a64-63e6943817bf")
		(effects (font (size 0.9 0.9) (thickness 0.135)) (justify left))
	)
