	(footprint "SB1:HLK-LD2450_Module_2x04_P2.00mm"
		(layer "F.Cu")
		(uuid "361475ad-1072-5cde-8f41-449f7d35b927")
		(at 85 58.2)
		(descr "Hi-Link HLK-LD2450 24 GHz radar (44 x 15 mm) board-mounted on a 2x4 2.00 mm socket, antenna side up. Pads 1 5V, 2 GND, 3 TX (module out), 4 RX (module in) match the LD2450_Port symbol; DM, DP, 3V3out and PA9 positions are unconnected (NC). Header at the left end seen from the antenna side (confirm on a module). The module back carries a 5 mm tall 4-pin socket at the other end: keep the area under the module empty. F.Cu keep-out keeps the GND pour solid under the module.")
		(tags "HLK-LD2450 LD2450 mmWave radar 24GHz module socket 2.00mm")
